<?xml version="1.0" encoding="utf-8"?>
<!-- El vigía de Shorts y Reels (Vigia.java). Recibe los eventos de todas las
     apps para saber cuándo salir de YouTube o Instagram y quitar la tapa, pero
     solo mira la pantalla de esas dos. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="0"
    android:description="@string/vigia_descripcion" />
